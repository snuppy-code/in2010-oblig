#: in2010_testrunner/in2010_testrunner.py:49
msgid "Not initialized. Are you sure you are in the right directory"
msgstr "Ikke initialisert. Er du i riktig mappe?"

#: in2010_testrunner/in2010_testrunner.py:87
msgid "cmd"
msgstr "kommando"

#: in2010_testrunner/in2010_testrunner.py:121
msgid "Command not found"
msgstr "Fann ikkje kommandoen"

#: in2010_testrunner/in2010_testrunner.py:125
msgid "Commands:"
msgstr "Kommandoar:"

#: in2010_testrunner/in2010_testrunner.py:126
msgid "    help, h     Print help"
msgstr "    hjelp, h      Vis hjelp"

#: in2010_testrunner/in2010_testrunner.py:127
msgid "    run         Run and test your code"
msgstr "    køyr          Køyr og test koden din"

#: in2010_testrunner/in2010_testrunner.py:128
msgid "    update      Download new stuff"
msgstr "    oppdater      Last ned nye filer"

#: in2010_testrunner/in2010_testrunner.py:129
msgid "    quit        Exit the program"
msgstr "    avslutt, q    Avslutt programmet"

#: in2010_testrunner/in2010_testrunner.py:130
msgid "    clear       clear the screen"
msgstr "    cls           Tøm skjermen"

#: in2010_testrunner/in2010_testrunner.py:131
msgid "    compile, c  Compile the java code"
msgstr "    kompiler, k   Kompiler java-koden"

#: in2010_testrunner/in2010_testrunner.py:132
msgid "    reload      Reload oppgaver.cfg"
msgstr "    r             Last inn oppgaver.cfg på nytt"

#: in2010_testrunner/in2010_testrunner.py:133
msgid "    bug         Report a bug"
msgstr "    bug           Rapporter ein feil i programmet"

#: in2010_testrunner/in2010_testrunner.py:134
msgid "    zip         Make zip files"
msgstr "    zip           Lag zipfil"

#: in2010_testrunner/in2010_testrunner.py:152
msgid ""
"This directory is not empty. Create and enter a new directory before "
"using in2010-testrunner"
msgstr ""
"Denne mappe er ikkje tom. Lag ein my mappe og køyr in2010-testrunner frå "
"den nye mappa"

#: in2010_testrunner/in2010_testrunner.py:154
msgid ""
"If you’re a group with more than one person, write all usernames with "
"spaces between"
msgstr ""
"Om du leverer i ei gruppe med meir enn ein person, skriv alle namna med "
"mellomrom mellom"

#: in2010_testrunner/in2010_testrunner.py:157
msgid "UiO username"
msgstr "UiO brukarnamn"

#: in2010_testrunner/in2010_testrunner.py:226
#, python-brace-format
msgid "{exercise} - {language} - OK"
msgstr "{exercise} - {language} - OK"

#: in2010_testrunner/in2010_testrunner.py:231
#, python-brace-format
msgid "{exercise} - {language} - {case}: used more than {seconds}s"
msgstr "{exercise} - {language} - {case}: brukte meir enn {seconds}s"

#: in2010_testrunner/in2010_testrunner.py:239
#, python-brace-format
msgid "{exercise} - {language} - {case}: wrong output: ‘{message}’"
msgstr "{exercise} - {language} - {case}: feil output: ‘{message}’"

#: in2010_testrunner/in2010_testrunner.py:247
#, python-brace-format
msgid ""
"{exercise} - {language} - {case}: too much output. line {linenum} should "
"not exist"
msgstr ""
"{exercise} - {language} - {case}: for mykje output. line {linenum} skulle"
" ikkje eksistert"

#: in2010_testrunner/in2010_testrunner.py:255
#, python-brace-format
msgid "{exercise} - {language} - {case}: not enough output"
msgstr "{exercise} - {language} - {case}: ikkje nok output"

#: in2010_testrunner/in2010_testrunner.py:263
#, python-brace-format
msgid ""
"{exercise} - {language} - {case}: wrong output at line {linenum}. "
"Expected ‘{expected}’, got ‘{got}’"
msgstr ""
"{exercise} - {language} - {case}: feil output på linje {linenum}. "
"Forventa ‘{expected}’, men fekk ‘{got}’"

#: in2010_testrunner/in2010_testrunner.py:274
#, python-brace-format
msgid "{exercise} - {language} - {case}: crashed with error message:"
msgstr "{exercise} - {language} - {case}: kræsja med feilmelding:"

